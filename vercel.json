{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/linkedin",
      "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=portfolio&utm_content=dados_contato",
      "permanent": false
    },
    {
      "source": "/curriculo",
      "destination": "/?utm_source=curriculo&utm_medium=pdf&utm_campaign=portfolio",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "/?utm_source=github&utm_medium=social&utm_campaign=portfolio&utm_content=overview",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/projects/ei-databot",
      "destination": "/_seo/ei-databot.html"
    },
    {
      "source": "/contact",
      "destination": "/_seo/contact.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/_seo/privacy-policy.html"
    },
    {
      "source": "/terms-of-use",
      "destination": "/_seo/terms-of-use.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
